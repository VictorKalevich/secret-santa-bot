# Зависимости и локальные артефакты
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
*.log
test-results/

# Секреты никогда не коммитим
.env
.env.*

# Локальные настройки агента (может содержать личные данные)
.claude/settings.local.json

# ОС
.DS_Store
Thumbs.db

# Резервные копии базы (wrangler d1 export): в них письма, переписка, пары и адреса.
# Схема — только миграции, они в git остаются.
*.sql
!migrations/*.sql
