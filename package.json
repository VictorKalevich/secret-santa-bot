{
  "name": "secret-santa-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-бот «Тайный Санта» на Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --port 8787",
    "deploy": "wrangler deploy",
    "test": "node --test tests/draw.test.mjs tests/design-system.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=20"
  }
}
